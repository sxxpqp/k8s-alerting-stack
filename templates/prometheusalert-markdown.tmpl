{{ with $v.labels.namespace }}命名空间：{{ . }}{{ end }}
{{ with $v.labels.ingress }}Ingress：{{ . }}{{ end }}
{{ with $v.labels.node }}节点：{{ . }}{{ end }}
{{ with $v.labels.pod }}Pod：{{ . }}{{ end }}
{{ with $v.labels.deployment }}Deployment：{{ . }}{{ end }}
{{ with $v.labels.statefulset }}StatefulSet：{{ . }}{{ end }}
{{ with $v.labels.daemonset }}DaemonSet：{{ . }}{{ end }}
{{ with $v.labels.persistentvolumeclaim }}PVC：{{ . }}{{ end }}
