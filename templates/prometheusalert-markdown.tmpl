{{ if $v.annotations.description }}说明：{{ $v.annotations.description }}{{ else if $v.annotations.summary }}说明：{{ $v.annotations.summary }}{{ else if $v.annotations.message }}说明：{{ $v.annotations.message }}{{ else }}说明：规则未提供 description / summary / message{{ end }}
